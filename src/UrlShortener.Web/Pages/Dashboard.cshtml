@page
@model UrlShortener.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-section">
    <div class="container">
        <div class="dashboard-header">
            <h1>Dashboard</h1>
            <p>Manage your shortened URLs and view analytics</p>
        </div>
        
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">@Model.TotalUrls</div>
                <div class="stat-label">Total Links</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@Model.TotalClicks</div>
                <div class="stat-label">Total Clicks</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@Model.ActiveUrls</div>
                <div class="stat-label">Active Links</div>
            </div>
        </div>
        
        @if (Model.Urls.Any())
        {
            <div class="urls-table-container">
                <table class="urls-table">
                    <thead>
                        <tr>
                            <th>Short URL</th>
                            <th>Original URL</th>
                            <th>Clicks</th>
                            <th>Created</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var url in Model.Urls)
                        {
                            <tr>
                                <td>
                                    <a href="/@url.ShortCode" target="_blank" class="short-link">
                                        /@url.ShortCode
                                    </a>
                                </td>
                                <td class="original-url-cell" title="@url.OriginalUrl">
                                    @TruncateUrl(url.OriginalUrl, 50)
                                </td>
                                <td class="clicks-cell">
                                    <span class="click-count">@url.ClickCount</span>
                                </td>
                                <td>@url.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (url.IsActive && !url.IsExpired)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else if (url.IsExpired)
                                    {
                                        <span class="status-badge status-expired">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>
                                <td class="actions-cell">
                                    <a href="/Analytics/@url.Id" class="btn-action btn-analytics" title="View Analytics">
                                        📊
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@url.Id" class="inline-form">
                                        <button type="submit" class="btn-action btn-delete" title="Delete" onclick="return confirm('Are you sure you want to delete this URL?')">
                                            🗑️
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">🔗</div>
                <h3>No URLs yet</h3>
                <p>Create your first shortened URL to get started</p>
                <a href="/" class="btn btn-primary">Create URL</a>
            </div>
        }
    </div>
</div>

@functions {
    string TruncateUrl(string url, int maxLength)
    {
        if (url.Length <= maxLength) return url;
        return url.Substring(0, maxLength) + "...";
    }
}
