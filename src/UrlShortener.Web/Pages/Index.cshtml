@page
@model UrlShortener.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <div class="container">
        <h1 class="hero-title">Shorten Your Links</h1>
        <p class="hero-subtitle">Create short, memorable URLs with click tracking and analytics</p>
        
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                <span class="alert-icon">⚠️</span>
                @Model.ErrorMessage
            </div>
        }
        
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">
                <span class="alert-icon">✅</span>
                @Model.SuccessMessage
            </div>
        }
        
        <form method="post" class="shorten-form">
            <div class="form-group">
                <label for="originalUrl">Enter your long URL</label>
                <input type="url" 
                       id="originalUrl" 
                       name="OriginalUrl" 
                       asp-for="OriginalUrl"
                       placeholder="https://example.com/very-long-url-here" 
                       required />
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label for="customCode">Custom code (optional)</label>
                    <input type="text" 
                           id="customCode" 
                           name="CustomCode" 
                           asp-for="CustomCode"
                           placeholder="my-custom-link" 
                           pattern="[a-zA-Z0-9\-]{3,20}" />
                </div>
                
                <div class="form-group">
                    <label for="title">Title (optional)</label>
                    <input type="text" 
                           id="title" 
                           name="Title" 
                           asp-for="Title"
                           placeholder="My Link Title" />
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary">
                <span class="btn-icon">🔗</span>
                Shorten URL
            </button>
        </form>
        
        @if (Model.CreatedUrl != null)
        {
            <div class="result-card">
                <h3>Your shortened URL is ready!</h3>
                <div class="short-url-display">
                    <input type="text" 
                           id="shortUrl" 
                           value="@Model.CreatedUrl.ShortUrl" 
                           readonly />
                    <button type="button" 
                            class="btn btn-copy" 
                            onclick="copyToClipboard()">
                        📋 Copy
                    </button>
                </div>
                <p class="original-url">Original: @Model.CreatedUrl.OriginalUrl</p>
            </div>
        }
    </div>
</div>

<section class="features-section">
    <div class="container">
        <h2>Features</h2>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <h3>Fast Redirects</h3>
                <p>Links are cached for instant redirects with minimal latency</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3>Click Analytics</h3>
                <p>Track clicks, referrers, devices, and browsers in real-time</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🎯</div>
                <h3>Custom Links</h3>
                <p>Create memorable custom short codes for your URLs</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⏰</div>
                <h3>Expiration</h3>
                <p>Set expiration dates for temporary links that auto-expire</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function copyToClipboard() {
            var copyText = document.getElementById("shortUrl");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);
            
            var btn = document.querySelector('.btn-copy');
            btn.textContent = '✓ Copied!';
            setTimeout(function() {
                btn.textContent = '📋 Copy';
            }, 2000);
        }
    </script>
}
